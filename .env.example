# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Supabase configuration (PostgreSQL backend)
# If provided, the system synchronizes records, embeddings, and categories with Supabase.
# If omitted or not configured yet, the system works seamlessly with resilient server-side storage and local persistence.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

